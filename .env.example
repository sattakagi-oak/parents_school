# 値は .env.local（ローカル）と Vercel Environment Variables にだけ設定する。このファイルに実値を書かない。

# LINE Messaging API（LINE Developers > チャネル）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 送信モード: disabled（既定・誰にも送らない） / test（テスト用ユーザーのみ） / production
LINE_SEND_MODE=disabled
# production にするには LINE_SEND_ENABLED=true も必要（二重ロック）
LINE_SEND_ENABLED=false
# test モードで送ってよいLINE userId（カンマ区切り）
LINE_TEST_USER_IDS=
# LINEから「テスト登録 <この値>」と送ると、そのアカウントをテスト送信対象に登録（16文字以上。未設定なら無効）
LINE_TEST_REGISTER_CODE=

# Neon Postgres（Vercel の Neon 連携 / neon env pull が自動で設定する名前）
# DATABASE_URL          … pooled（ホスト名に -pooler）。アプリが使用
# DATABASE_URL_UNPOOLED … 直結。マイグレーションが優先して使用（無ければ DATABASE_URL）
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 管理API認証用（32文字以上のランダム文字列）
ADMIN_API_TOKEN=

# 「わが子の強み・伸ばし方 個別分析」の申込ページURL（https://〜）。未設定なら個数回答後のカードを出さない
PARENT_DIAGNOSIS_URL=
# このサイトの公開URL（例: https://parents-school.vercel.app）。チェックリスト画像URL・CTAリンク生成に使用
PUBLIC_BASE_URL=

# Vercel Cron 認証用（32文字以上のランダム文字列）。設定すると Vercel Cron が自動で Authorization ヘッダーに付ける
CRON_SECRET=

# 無料講座（Zoom）: true にすると申込受付・リマインドを全員に開放。未設定ならテスト用ユーザーだけ
WEBINAR_ENABLED=
# Zoom 参加情報（公開リポジトリなのでコードには書かない）
WEBINAR_ZOOM_URL=
WEBINAR_ZOOM_MEETING_ID=
WEBINAR_ZOOM_PASSCODE=
