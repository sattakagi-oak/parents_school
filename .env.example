# 値は .env.local（ローカル）と Vercel Environment Variables にだけ設定する。このファイルに実値を書かない。

# LINE Messaging API（LINE Developers > チャネル）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 送信モード: disabled（既定・誰にも送らない） / test（LINE_TEST_USER_IDSのみ） / production
LINE_SEND_MODE=disabled
# production にするには LINE_SEND_ENABLED=true も必要（二重ロック）
LINE_SEND_ENABLED=false
# test モードで送ってよいLINE userId（カンマ区切り）
LINE_TEST_USER_IDS=

# Neon Postgres（Vercel の Neon 連携 / neon env pull が自動で設定する名前）
# DATABASE_URL          … pooled（ホスト名に -pooler）。アプリが使用
# DATABASE_URL_UNPOOLED … 直結。マイグレーションが優先して使用（無ければ DATABASE_URL）
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Cron 認証用（32文字以上のランダム文字列）
CRON_SECRET=
# 管理API認証用（32文字以上のランダム文字列）
ADMIN_API_TOKEN=

# 1,000円診断の申込ページURL（https://〜）。未設定の間はCTAを送らず保留
PARENT_DIAGNOSIS_URL=
# このサイトの公開URL（例: https://parents-school.vercel.app）。CTAリンク生成に使用
PUBLIC_BASE_URL=
